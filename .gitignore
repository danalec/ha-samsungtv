# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Local environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Never commit real credentials. The TV token is requested by the config flow
# and stored by Home Assistant under the config directory, never in the repo.
.env
.env.*
*.token
